# OpenRouter (server-side only — never expose to the client)
OPENROUTER_API_KEY=
# One OpenRouter model ID per line (see https://openrouter.ai/models).
# Model used for conversational, streamed responses (Dialogue Orchestrator)
PATHWAYS_CHAT_MODEL=anthropic/claude-sonnet-5.5
# Model used for schema-constrained JSON output (Memory & State, Fact-Finder).
# Must support structured outputs; runs several times per message, so favor speed.
PATHWAYS_STRUCTURED_MODEL=anthropic/claude-haiku-4.5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by migration and data-loading scripts.
DATABASE_URL=

# OpenAI (server-side only), used for voice: speech-to-text and text-to-speech.
OPENAI_API_KEY=

# Secrets (generate each with: openssl rand -hex 32)
# Keys the HMAC of access codes. Rotating it invalidates every stored code.
ACCESS_CODE_SECRET=
# Signs session cookies.
SESSION_SECRET=
# Protects the scheduled data refresh endpoints (/api/cron/sync/*).
CRON_SECRET=

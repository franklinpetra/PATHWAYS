# OpenRouter (server-side only — never expose to the client)
OPENROUTER_API_KEY=
# Model used for conversational, streamed responses (Dialogue Orchestrator)
PATHWAYS_CHAT_MODEL=
# Model used for schema-constrained JSON output (Memory & State, Fact-Finder)
PATHWAYS_STRUCTURED_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secrets (generate each with: openssl rand -hex 32)
# Keys the HMAC of access codes. Rotating it invalidates every stored code.
ACCESS_CODE_SECRET=
# Signs session cookies.
SESSION_SECRET=
